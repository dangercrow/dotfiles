#!/usr/bin/env python3
"""Freeze an app's systemd scope, push its memory to swap, and thaw it on Enter.

    freeze                # Firefox (default)
    freeze steam          # anything matching *steam*
    freeze 'app-foo-*.scope' --no-reclaim

Works on the systemd user unit the app runs in (e.g. the Flatpak's
app-flatpak-org.mozilla.firefox-*.scope), so every child process is covered.
No root needed: the user manager owns these cgroups. Ctrl-C, EOF, or closing
the terminal also thaws.
"""

import argparse
import errno
import signal
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path

DEFAULT_PATTERN = "app-flatpak-org.mozilla.firefox-*.scope"
RECLAIM_CHUNK = 256 * 1024**2  # reclaim in steps so a partial failure still makes progress


def find_units(pattern: str) -> list[str]:
    if not any(c in pattern for c in "*?[."):
        pattern = f"*{pattern}*"
    out = subprocess.run(
        ["systemctl", "--user", "list-units", "--no-legend", "--plain",
         "--type=scope,service", pattern],
        capture_output=True, text=True, check=True,
    ).stdout
    return [line.split()[0] for line in out.splitlines() if line.strip()]


def cgroup_dir(unit: str) -> Path:
    cg = subprocess.run(
        ["systemctl", "--user", "show", "-P", "ControlGroup", unit],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return Path("/sys/fs/cgroup") / cg.lstrip("/")


def read_int(path: Path) -> int:
    return int(path.read_text().split()[0])


def human(n: int) -> str:
    for unit in ("B", "K", "M", "G"):
        if n < 1024 or unit == "G":
            return f"{n:.1f}{unit}" if unit != "B" else f"{n}B"
        n /= 1024


def usage(cg: Path) -> str:
    ram = read_int(cg / "memory.current")
    swap = read_int(cg / "memory.swap.current")
    return f"RAM {human(ram)}, swap {human(swap)}"


def is_frozen(cg: Path) -> bool:
    return (cg / "cgroup.freeze").read_text().strip() == "1"


def reclaim(cg: Path) -> None:
    """Ask the kernel to evict the cgroup's pages until it can't any more."""
    target = cg / "memory.reclaim"
    while read_int(cg / "memory.current") > RECLAIM_CHUNK:
        print(f"\r  swapping out: {usage(cg)}  (Ctrl-C to stop) ", end="", flush=True)
        try:
            target.write_text(str(RECLAIM_CHUNK))
        except OSError as e:
            if e.errno == errno.EAGAIN:  # kernel couldn't reclaim the full chunk: done
                break
            raise
        except KeyboardInterrupt:  # stop swapping, but stay frozen
            break
    print()


@contextmanager
def frozen(units: list[str], swap_out: bool = True):
    """Freeze units for the duration of the block, thawing them on exit."""
    done = []
    try:
        for unit in units:
            cg = cgroup_dir(unit)
            if is_frozen(cg):
                print(f"{unit}: already frozen, leaving it alone")
                continue
            subprocess.run(["systemctl", "--user", "freeze", unit], check=True)
            done.append(unit)
            print(f"{unit}: frozen ({usage(cg)})")
            if swap_out:
                reclaim(cg)
                print(f"  now: {usage(cg)}")
        yield
    finally:
        for unit in done:
            subprocess.run(["systemctl", "--user", "thaw", unit], check=True)
            print(f"{unit}: thawed ({usage(cgroup_dir(unit))})")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("unit", nargs="?", default=DEFAULT_PATTERN,
                    help=f"unit name, glob, or plain substring (default: {DEFAULT_PATTERN})")
    ap.add_argument("--no-reclaim", action="store_true",
                    help="freeze only; let the kernel swap it out lazily")
    args = ap.parse_args()

    units = find_units(args.unit)
    if not units:
        print(f"No running unit matches {args.unit!r}", file=sys.stderr)
        return 1

    # Closing the terminal or `kill` should still thaw, so make them unwind like Ctrl-C.
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))

    with frozen(units, swap_out=not args.no_reclaim):
        try:
            input("Press Enter to thaw... ")
        except (EOFError, KeyboardInterrupt):
            print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
